          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH cumulative_data AS (\n    SELECT\n        date,\n        a.id,\n        CONCAT(a.first_name, ' ', a.last_name) AS athlete_name,\n        SUM(CAST(distance_run AS numeric)) OVER (PARTITION BY a.id ORDER BY date) AS cumulative_distance\n    FROM athletes a\n    JOIN activities ac ON a.id = ac.athlete_id\n)\nSELECT\n    date,\n    jsonb_object_agg(athlete_name, cumulative_distance) AS athletes_data\nFROM cumulative_data\nGROUP BY date\nORDER BY date;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Distance Cumulative par athlète",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "delimiter": ",",
            "source": "athletes_data"
          }
